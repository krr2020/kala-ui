{
	"name": "@kala-ui/react-hooks",
	"version": "0.1.0-beta.0",
	"type": "module",
	"sideEffects": false,
	"description": "Collection of reusable React hooks for kala-ui",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:fix-unsafe": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": false
		},
		"react-dom": {
			"optional": false
		}
	},
	"devDependencies": {
		"@testing-library/react": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"jsdom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "~0.22.14",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"keywords": [
		"react",
		"hooks",
		"utilities",
		"kala-ui",
		"react-hooks"
	],
	"author": "Kala UI",
	"license": "MIT",
	"homepage": "https://krr2020.com/kala-ui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/krr2020/kala-ui.git",
		"directory": "packages/react-hooks"
	},
	"bugs": {
		"url": "https://github.com/krr2020/kala-ui/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
