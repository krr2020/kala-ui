{
	"name": "@kala-ui/react-native",
	"version": "0.1.0-beta.0",
	"description": "Token-driven theming system for kala-ui on React Native — Unistyles themes transcribed from the web token source of truth. Components arrive in later releases.",
	"keywords": [
		"react-native",
		"expo",
		"ui",
		"design-system",
		"theming",
		"unistyles",
		"kala-ui",
		"typescript"
	],
	"author": "Kala UI",
	"license": "MIT",
	"homepage": "https://krr2020.com/kala-ui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/krr2020/kala-ui.git",
		"directory": "packages/react-native"
	},
	"bugs": {
		"url": "https://github.com/krr2020/kala-ui/issues"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./themes": "./src/themes.ts",
		"./tokens": "./src/tokens.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc --noEmit",
		"type-check": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"lint:fix-unsafe": "biome lint . --write --unsafe",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"react": ">=19.2.0",
		"react-native": ">=0.86.0",
		"react-native-reanimated": ">=4.5.0",
		"react-native-unistyles": "3.3.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"react-native": "catalog:",
		"react-native-reanimated": "catalog:",
		"react-native-unistyles": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
