{
  "project": {
    "name": "kala ui",
    "root": "/Users/rk/workspace/kala-ui"
  },
  "projects": {
    "roots": [],
    "ignore": [],
    "overrides": {}
  },
  "execution": {
    "worktrees": true
  },
  "agent": {
    "defaultMode": "build",
    "approvalPosture": "auto",
    "guardian": {
      "enabled": true,
      "timeoutMs": 30000,
      "maxConsecutiveDenials": 3,
      "cooldownMs": 900000
    },
    "compaction": {
      "autoEnabled": false,
      "thresholdPercent": 80,
      "keepRecentTokens": 20000,
      "readEarlyEnabled": false
    },
    "chatSpendLimitUsd": 5,
    "chatMaxTurns": 120,
    "chatMaxToolCalls": 300,
    "sessions": {
      "retentionDays": 30
    },
    "learning": {
      "enabled": true,
      "reviewQueue": true,
      "maxSkills": 50,
      "consolidationEnabled": true
    },
    "sessionCritique": {
      "enabled": false,
      "fixFindings": false,
      "severityFloor": "high",
      "transcriptBudgetTokens": 40000
    },
    "showReasoning": true,
    "showStepNarration": false,
    "shiftEnterToSubmit": false,
    "chatAutoValidate": false,
    "coordinator": {
      "enabled": true
    },
    "spawns": {},
    "debug": {
      "llmCapture": {
        "enabled": true,
        "captureRequestBody": true,
        "captureResponseBody": true,
        "retentionDays": 7,
        "otlp": {
          "enabled": false
        }
      },
      "logsEnabled": true
    },
    "sandbox": {
      "mode": "auto",
      "extraWritableRoots": []
    },
    "outputCompaction": {
      "enabled": true,
      "gitLogLines": 10,
      "diffContext": 1
    },
    "efficiencyNudges": {
      "enabled": true,
      "redundantReadThreshold": 4,
      "serialReadTurns": 3,
      "diagnosticsThreshold": 3,
      "reworkEditThreshold": 3,
      "planRewriteThreshold": 2,
      "repeatFailureThreshold": 2,
      "toolFailureThreshold": 3,
      "browserProbeThreshold": 6,
      "reasoningRepeatThreshold": 2,
      "minWindowTurns": 4,
      "maxNudgesPerTurn": 2,
      "maxReminders": 2,
      "weights": {
        "redundantRead": 1,
        "repeatFailure": 2,
        "toolFailure": 2,
        "browserProbe": 2,
        "reworkEdit": 3,
        "violation": 5,
        "planRewrite": 8,
        "reasoningRepeat": 4
      }
    }
  },
  "autonomy": {
    "requireApprovalBeforeCommit": false,
    "stopAfter": "feature",
    "resumeAfterApproval": true,
    "approvalTimeoutMinutes": 120,
    "approvalTimeoutDecision": "auto-decide",
    "reviewResumeTimeoutMinutes": 15,
    "autoAdoptGates": [],
    "autoAccept": "recommended",
    "workingHours": null,
    "prioritizeBugfixes": true,
    "laneCap": 1,
    "planReviewGate": false,
    "outageRetryLimit": 2,
    "outageRetryBackoffSeconds": 30,
    "outageResumeTimeoutMinutes": 15,
    "outageMaxAutoResumes": 3
  },
  "approvals": {
    "allow": [],
    "block": []
  },
  "git": {
    "autoCommit": true,
    "snapshots": true,
    "branchPer": "auto",
    "baseBranch": "main",
    "commitMessageTemplate": "{commitType}({taskId}): {title}",
    "autoPush": true,
    "autoPR": false,
    "autoCommitWiki": true,
    "prTitleTemplate": "{storyId}: {storyTitle}",
    "prBodyTemplate": "Completed work on {storyTitle}.\n\n## Tasks\n"
  },
  "ux": {
    "enabled": true,
    "generation": {
      "designSystem": true,
      "screens": true,
      "depth": "standard"
    },
    "validation": {
      "viewports": [
        {
          "name": "desktop",
          "width": 1280,
          "height": 720
        },
        {
          "name": "mobile",
          "width": 390,
          "height": 844
        }
      ],
      "fullPage": false,
      "browserMatch": {
        "enabled": true,
        "strictness": "loose"
      },
      "uiValidation": {
        "enabled": false
      },
      "visualBaseline": {
        "enabled": false,
        "threshold": 0.1,
        "maxDiffPercent": 1,
        "ignoreRegions": []
      }
    },
    "agentBrowser": {
      "enabled": true,
      "advancedAutomation": true
    }
  },
  "planning": {
    "autoPlan": true
  },
  "codeIntel": {
    "lsp": {
      "enabled": true,
      "idleShutdownMin": 3,
      "maxServers": 2
    },
    "formatter": {
      "enabled": true,
      "autoApply": false
    }
  },
  "gates": {
    "lint": true,
    "typecheck": true,
    "test": true,
    "build": false,
    "overrides": {},
    "order": [
      "lint",
      "typecheck",
      "test",
      "build"
    ],
    "timeoutMs": 300000,
    "flakyRetries": 0,
    "autoFix": {
      "enabled": true
    },
    "isolation": {
      "enabled": false,
      "deps": "symlink"
    },
    "device": {
      "enabled": false
    }
  },
  "feedback": {
    "readGuard": {
      "enabled": true,
      "maxHashLines": 3000,
      "exempt": [
        ".md",
        ".markdown",
        ".txt",
        ".log"
      ]
    },
    "format": {
      "enabled": true,
      "budgetMs": 5000,
      "validateParse": true
    },
    "diagnostics": {
      "mode": "block",
      "budgetMs": 4000,
      "maxFindings": 12,
      "blockOn": [
        "error"
      ]
    },
    "cascade": {
      "enabled": true,
      "maxImporters": 10,
      "perFileBudgetMs": 3000
    },
    "actionableWarnings": {
      "autoFix": true,
      "maxFixes": 5
    },
    "lineLimit": {
      "enabled": true,
      "mode": "warn",
      "maxLines": 500,
      "include": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts",
        ".vue",
        ".svelte",
        ".astro",
        ".py",
        ".go",
        ".rs",
        ".java",
        ".kt",
        ".rb",
        ".php",
        ".cs",
        ".swift",
        ".c",
        ".cc",
        ".cpp",
        ".h",
        ".hpp"
      ],
      "exclude": [
        ".md",
        ".mdx",
        ".markdown",
        ".txt",
        ".log",
        ".json",
        ".jsonc",
        ".yaml",
        ".yml",
        ".toml",
        ".csv",
        ".sql",
        ".html",
        ".htm",
        ".css",
        ".scss",
        ".less",
        ".svg",
        ".lock"
      ]
    },
    "commentGate": "advisory",
    "cleanCodeGate": "block"
  },
  "wiki": {
    "autoRefresh": true,
    "refreshIntervalHours": 24,
    "checkIntervalMinutes": 60
  },
  "codeIntelligence": {
    "enabled": true,
    "sources": {
      "excludeDirs": []
    },
    "symbols": {
      "enabled": true
    },
    "graph": {
      "enabled": true
    },
    "includeNestedRepos": false,
    "embeddings": {
      "enabled": true,
      "provider": "local-dense"
    }
  },
  "autocomplete": {
    "enabled": true,
    "models": {},
    "fimMode": "auto",
    "debounce": "adaptive",
    "candidates": 1,
    "manualTriggerShortcut": "Mod-Space",
    "symbolContext": true,
    "promptCompletion": true,
    "nextEdits": true
  },
  "fileBrowser": {
    "hiddenFiles": [
      "node_modules",
      "dist",
      "build",
      "out",
      "coverage",
      ".git",
      ".next",
      ".nuxt",
      ".svelte-kit",
      ".astro",
      ".angular",
      ".vite",
      ".turbo",
      ".parcel-cache",
      ".docusaurus",
      ".cache",
      ".conveyor",
      ".expo",
      "Pods",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      ".venv",
      ".gradle",
      ".terraform",
      ".dart_tool",
      ".vscode",
      ".idea",
      ".vs",
      ".history",
      ".DS_Store",
      "Thumbs.db",
      "desktop.ini"
    ],
    "pinnedFiles": [],
    "wordWrap": false,
    "formatOnSave": false,
    "openMode": "open-each"
  },
  "board": {
    "tombstoneRetentionHours": 24
  }
}
