{
	"name": "@kala-ui/native-playground",
	"version": "0.0.0",
	"private": true,
	"description": "Expo app exercising @kala-ui/react-native tokens — living docs for the native theming system",
	"main": "index.js",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"android:watch": "adb reverse tcp:8081 tcp:8081; adb shell am force-stop com.anonymous.kalanativeplayground; ( until curl -sf -m 2 -o /dev/null http://127.0.0.1:8081/status; do sleep 1; done; adb shell am start -n com.anonymous.kalanativeplayground/.MainActivity ) & expo start",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"export": "expo export --platform web"
	},
	"dependencies": {
		"@expo/metro-runtime": "catalog:",
		"@kala-ui/react-native": "workspace:*",
		"@kala-ui/react-native-app": "workspace:*",
		"@react-native/normalize-colors": "catalog:",
		"expo": "catalog:",
		"lucide-react-native": "catalog:",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "catalog:",
		"react-native-edge-to-edge": "catalog:",
		"react-native-gesture-handler": "catalog:",
		"react-native-nitro-modules": "catalog:",
		"react-native-reanimated": "catalog:",
		"react-native-safe-area-context": "catalog:",
		"react-native-screens": "catalog:",
		"react-native-svg": "catalog:",
		"react-native-unistyles": "catalog:",
		"react-native-worklets": "0.10.1",
		"react-native-web": "catalog:"
	},
	"devDependencies": {
		"@react-native/metro-config": "catalog:",
		"@types/react": "catalog:",
		"babel-preset-expo": "catalog:",
		"jest-expo": "catalog:",
		"typescript": "catalog:"
	}
}
