{
	"name": "kala-ui",
	"private": true,
	"description": "Kala UI - A React component library with a token-driven theming system",
	"license": "MIT",
	"author": "Kala UI",
	"homepage": "https://krr2020.com/kala-ui",
	"packageManager": "pnpm@10.17.1",
	"scripts": {
		"dev": "pnpm --filter @kala-ui/react dev",
		"build": "pnpm --filter \"./packages/**\" build",
		"build:apps": "pnpm --filter \"./apps/**\" build",
		"build:react": "pnpm --filter @kala-ui/react build",
		"type-check": "pnpm --filter \"./packages/**\" type-check",
		"lint": "node scripts/check-package-boundaries.mjs && pnpm --filter \"./packages/**\" lint",
		"lint:fix": "pnpm --filter \"./packages/**\" lint:fix",
		"lint:fix-unsafe": "pnpm --filter \"./packages/**\" lint:fix-unsafe",
		"format": "pnpm --filter \"./packages/**\" format",
		"test": "pnpm --filter \"./packages/**\" test",
		"test:watch": "pnpm --filter @kala-ui/react --filter @kala-ui/react-app test:watch",
		"test:coverage": "pnpm --filter @kala-ui/react --filter @kala-ui/react-app test:coverage",
		"storybook": "pnpm --filter @kala-ui/react storybook",
		"build-storybook": "pnpm --filter @kala-ui/react build-storybook",
		"test-storybook": "node scripts/test-storybook.mjs",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"clean": "node scripts/clean.mjs"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@changesets/cli": "3.0.1",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"http-server": "^14.1.1",
		"postcss-cli": "^11.0.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	},
	"pnpm": {
		"overrides": {
			"react-native-worklets": "0.10.1"
		}
	}
}
