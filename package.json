{
	"name": "kala-ui",
	"private": true,
	"description": "Kala UI - A React component library with a token-driven theming system",
	"license": "MIT",
	"author": "Kala UI",
	"homepage": "https://krr2020.com/kala-ui",
	"scripts": {
		"dev": "pnpm --filter @kala-ui/react dev",
		"build": "pnpm --filter \"./packages/**\" build",
		"build:react": "pnpm --filter @kala-ui/react build",
		"type-check": "pnpm --filter \"./packages/**\" type-check",
		"lint": "pnpm --filter \"./packages/**\" lint",
		"lint:fix": "pnpm --filter \"./packages/**\" lint:fix",
		"lint:fix-unsafe": "pnpm --filter \"./packages/**\" lint:fix-unsafe",
		"format": "pnpm --filter \"./packages/**\" format",
		"test": "pnpm --filter \"./packages/**\" test",
		"test:watch": "pnpm --filter @kala-ui/react test:watch",
		"test:coverage": "pnpm --filter @kala-ui/react test:coverage",
		"storybook": "pnpm --filter @kala-ui/react storybook",
		"build-storybook": "pnpm --filter @kala-ui/react build-storybook",
		"test-storybook": "pnpm --filter @kala-ui/react test-storybook",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"clean": "node scripts/clean.mjs"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@changesets/cli": "3.0.1",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.5",
		"postcss-cli": "^11.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "~7.0.2"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	}
}
